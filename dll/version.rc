/* The version details Windows shows under the DLL's Properties > Details. */
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     LID_DLL_VERSION_NUM
PRODUCTVERSION  LID_DLL_VERSION_NUM
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "KSFA"
            VALUE "FileDescription",  "Let It Die Fighter Class Passives - plugin for the LiD Plugin Loader"
            VALUE "FileVersion",      LID_DLL_VERSION
            VALUE "InternalName",     "lid-classpassives"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "lid-classpassives.dll"
            VALUE "ProductName",      "LiD Fighter Class Passives"
            VALUE "ProductVersion",   LID_DLL_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
